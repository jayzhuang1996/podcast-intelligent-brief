# AI Podcast Monitor - Environment Variables
# Copy this file to .env and fill in your values

# ============================================================================
# CLAUDE API
# ============================================================================
# Get your API key from: https://console.anthropic.com/
# REQUIRED for summarization to work
ANTHROPIC_API_KEY=your-anthropic-api-key-here

# ============================================================================
# DATABASE
# ============================================================================
# SQLite database file location
# Default: sqlite:///./data/podcast.db (creates file in data/ folder)
DATABASE_URL=sqlite:///./data/podcast.db

# ============================================================================
# YOUTUBE (Optional)
# ============================================================================
# YouTube Data API key (optional, for advanced features)
# yt-dlp works without API key for basic features
# Get key from: https://console.cloud.google.com/apis/credentials
# YOUTUBE_API_KEY=your-youtube-api-key-here

# ============================================================================
# APPLICATION SETTINGS
# ============================================================================
# How often to check channels for new episodes (in hours)
# Default: 6 hours
MONITOR_INTERVAL_HOURS=6

# Maximum number of episodes to process per channel per check
# Prevents overwhelming the system if channel uploads many videos at once
# Default: 5
MAX_EPISODES_PER_CHECK=5

# ============================================================================
# LOGGING
# ============================================================================
# Log level: DEBUG, INFO, WARNING, ERROR, CRITICAL
# Default: INFO
LOG_LEVEL=INFO

# Log file location
# Default: logs/app.log
LOG_FILE=logs/app.log

# ============================================================================
# DEVELOPMENT
# ============================================================================
# Set to True to enable debug mode (auto-reload, detailed errors)
# NEVER use True in production!
# Default: False
DEBUG=False

# ============================================================================
# SECURITY NOTES
# ============================================================================
# IMPORTANT:
# 1. NEVER commit .env file to Git (it's in .gitignore)
# 2. Keep your API keys secret
# 3. Rotate keys if accidentally exposed
# 4. Use different keys for development and production

# ============================================================================
# SETUP INSTRUCTIONS
# ============================================================================
# 1. Copy this file: cp .env.example .env
# 2. Get Claude API key from https://console.anthropic.com/
# 3. Replace ANTHROPIC_API_KEY value with your actual key
# 4. Optionally adjust other settings
# 5. Run: python scripts/init_db.py
# 6. Run: uvicorn src.main:app --reload
